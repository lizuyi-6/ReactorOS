[Unit]
Description=Reactor Edge Supervisor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/opt/reactor-edge
ExecStart=/opt/reactor-edge/bin/reactor-edge-daemon \
  --config /etc/reactor-edge/device.toml \
  --safety /etc/reactor-edge/safety.toml \
  --memory /etc/reactor-edge/ai_memory.toml \
  --db /var/lib/reactor-edge/reactor.sqlite3 \
  --assets auto \
  --safety-guard /opt/reactor-edge/bin/reactor-safety-guard \
  --bind 0.0.0.0:8000
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=-/var/lib/reactor-edge
# Required when using config/device.json_bridge.toml with /project/control.json.
# Adjust this path if json_bridge.control_path points elsewhere.
ReadWritePaths=-/project
# Optional real AI provider. Keep the key in this EnvironmentFile outside git.
# If STEPFUN_AI_ENABLED=true is set there, startup fails when the key is missing.
EnvironmentFile=-/etc/reactor-edge/reactor-edge.env

[Install]
WantedBy=multi-user.target
