[Unit]
Description=Reactor Edge SQLite Backup Snapshot
Wants=reactor-edge.service
After=reactor-edge.service

[Service]
Type=oneshot
User=pi
Group=pi
WorkingDirectory=/opt/reactor-edge/current
ExecStartPre=/usr/bin/mkdir -p /var/lib/reactor-edge/backups
ExecStart=/opt/reactor-edge/current/backup.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=-/var/lib/reactor-edge
EnvironmentFile=-/etc/reactor-edge/reactor-edge.env
