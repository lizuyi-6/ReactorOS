FROM debian:buster

ARG RUST_VERSION=1.90.0

ENV DEBIAN_FRONTEND=noninteractive
ENV CARGO_HOME=/cargo
ENV RUSTUP_HOME=/rustup
ENV PATH=/cargo/bin:${PATH}

RUN dpkg --add-architecture arm64 \
    && sed -i 's|deb.debian.org/debian|archive.debian.org/debian|g; s|security.debian.org/debian-security|archive.debian.org/debian-security|g; s|buster/updates|buster/updates|g' /etc/apt/sources.list \
    && printf 'Acquire::Check-Valid-Until "false";\n' >/etc/apt/apt.conf.d/99no-check-valid-until \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        build-essential \
        file \
        git \
        gcc-aarch64-linux-gnu \
        libc6-dev-arm64-cross \
        libudev-dev \
        libudev-dev:arm64 \
        pkg-config \
        binutils-aarch64-linux-gnu \
        tar \
        xz-utils \
        zip \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain ${RUST_VERSION} \
    && rustup component add rustfmt \
    && rustup target add aarch64-unknown-linux-gnu

WORKDIR /work

COPY scripts/package-a55-debian10.sh /usr/local/bin/package-a55-debian10.sh
RUN chmod +x /usr/local/bin/package-a55-debian10.sh

CMD ["/usr/local/bin/package-a55-debian10.sh"]
