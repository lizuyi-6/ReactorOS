/target/
# Cross-compile output dirs from the board package builds (e.g.
# target-lubancat2-arm64-buster, target-a55-arm64-buster). These are 1GB+
# build artifacts that must never enter the repo.
/target-*/
/.idea/
/.vscode/
/.env
/node_modules/
/frontend/dist/
# workshop/ is a large (136M+) standalone workspace; keep it out of the main repo.
/workshop/
/test-results/
/playwright-report/
dist/
data/*.sqlite3
data/*.sqlite3-*
data/*.db
data/*.db-*
config/reactor-edge.env
.playwright-mcp/
*.log

# Local agent notes / ad-hoc audit exports
/CLAUDE.md
/code_audit_report.md

# Generated training workspaces should not vendor dependencies.
/outputs/**/node_modules/

# Acceptance runs create scratch databases, logs and temporary extracted inputs.
/output/**/*.log
/output/**/*.sqlite3
/output/**/*.sqlite3-*
/output/**/*.db
/output/**/*.db-*
/output/**/*.key
/output/**/*.snapshot
/output/**/*.snapshot.sha256
/output/**/bogus.bin
/output/**/candidate-adapter.gguf
/output/**/active-adapter.gguf
/output/**/active-adapter.gguf.pre-promote-*.bak
/output/**/fake-qwen.gguf
/output/acceptance/acceptance-steps.jsonl
/output/acceptance/backup-script/
/output/acceptance/cli-smoke-*/
/output/acceptance/logs/
/output/acceptance/tmp/
/output/acceptance/*.conf
/output/local-run/*.log*
/output/local-run/*payload.json
/output/local-run/ainas-mqtt-selfcheck.json
/output/dev/
/output/playwright/
/output/compliance-audit-report-*.md
/output/team_*.txt
/output/xingshu_prd_pdf.txt
/output/index-script-check.js
/output/frame-*.jpg

# IDEA-generated local SQLite (regenerated each IDE session, machine-local)
/identifier.sqlite
# Output-root screenshots; subdirs like /output/playwright/ already ignored above
/output/*.png

# Claude Code local provenance hook (depends on machine-local
# .claude/settings.local.json + IDEA built-in server on 63342;
# not a shared project asset — script is reusable if team adopts it)
/.claude/hooks/
